# PostgreSQL connection string. In production, use the Neon POOLED (PgBouncer)
# endpoint, not the direct connection and not neon-http.
DATABASE_URL=postgresql://circle:circle@localhost:5432/circle

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-generated-secret

# Must EXACTLY match the origin serving the app, including the port. A mismatch
# makes better-auth reject browser requests with 403 responses.
BETTER_AUTH_URL=http://localhost:3002

# Optional. When absent, email verification is disabled and verification links
# are printed to the server console.
RESEND_API_KEY=re_example_key

# Optional sender identity for verification emails.
EMAIL_FROM=Circle <onboarding@example.com>
