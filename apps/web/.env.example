# PostgreSQL connection string. In production, use the Neon POOLED (PgBouncer)
# endpoint, not the direct connection and not neon-http.
DATABASE_URL=postgresql://circle:circle@localhost:5432/circle

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-generated-secret

# Must EXACTLY match the origin serving the app, including the port. A mismatch
# makes better-auth reject browser requests with 403 responses.
BETTER_AUTH_URL=http://localhost:3002

# Optional. When absent, email verification is disabled and verification links
# are printed to the server console.
RESEND_API_KEY=re_example_key

# Optional sender identity for verification emails.
EMAIL_FROM=Circle <onboarding@example.com>

# DEV ONLY. When both are set AND NODE_ENV is not production, GET /dev-login signs in
# as this user and redirects to /groups — a shortcut past the form, not an auth bypass:
# it creates a real session, so every permission check still applies.
# LEAVE THESE UNSET IN PRODUCTION. The route 404s without them.
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=

# Stock cover images for posts with no picture of their own, via Openverse.
# No API key needed — it works out of the box.
# NOTE: keywords derived from post titles/tags are sent to api.openverse.org.
# Set to 1 to stop all outbound cover requests.
STOCK_IMAGES_DISABLED=
# Optional: raises the Openverse rate limit. Not required.
OPENVERSE_API_TOKEN=
