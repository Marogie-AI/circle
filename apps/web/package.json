{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "test": "bun test --env-file=.env.local lib/ app/",
    "test:smoke-api": "bun scripts/smoke-api.ts",
    "typecheck": "tsc --noEmit",
    "db:check": "bun --env-file=.env.local drizzle-kit check",
    "db:generate": "bun --env-file=.env.local drizzle-kit generate",
    "db:migrate": "bun --env-file=.env.local drizzle-kit migrate",
    "db:seed": "bun --env-file=.env.local scripts/seed.ts",
    "db:verify": "bun scripts/verify-schema.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.25",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.0",
    "resend": "^4.0.0",
    "superjson": "^2.2.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^24",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
